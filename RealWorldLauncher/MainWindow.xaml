<Window x:Class="RealWorldLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealWorld Launcher" Width="1120" Height="720" MinWidth="900" MinHeight="600" Background="#0E1016" Foreground="#F4F6FA">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Открыть папку модов" Click="Mods_Click" Padding="14,8" Margin="8,0,0,0"/>
        <Button Content="Настройки" Click="Settings_Click" Padding="14,8" Margin="8,0,0,0"/>
      </StackPanel>
      <StackPanel><TextBlock Text="REALWORLD" FontSize="26" FontWeight="Bold"/><TextBlock Text="launcher · Minecraft 1.21.4" Foreground="#9EA7B8"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Сервер:" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="ServerBox" Width="230" DisplayMemberPath="Name" SelectionChanged="Server_Changed"/>
        <TextBox x:Name="AddressBox" Width="260" Margin="12,0,0,0" Padding="8" ToolTip="IP или домен сервера"/>
        <Button Content="Добавить сервер" Click="AddServer_Click" Padding="14,8" Margin="12,0,0,0"/>
        <Button Content="▶  Запустить выбранных" Click="Launch_Click" Padding="18,8" Margin="24,0,0,0" Background="{StaticResource Accent}" Foreground="#0E1016" FontWeight="Bold"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,16,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="+ Добавить твинка" Click="AddProfile_Click" Padding="12,8"/>
            <Button Content="Сохранить" Click="Save_Click" Padding="12,8" Margin="8,0,0,0"/>
          </StackPanel>
          <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Профиль твинка" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Никнейм" Grid.Row="0" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Padding="8"/>
            <TextBlock Text="Папка игры" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="DirBox" Grid.Row="1" Grid.Column="1" Padding="8"/>
            <TextBlock Text="Java" Grid.Row="2" VerticalAlignment="Center"/><TextBox x:Name="JavaBox" Grid.Row="2" Grid.Column="1" Padding="8"/>
            <TextBlock Text="RAM (MB)" Grid.Row="3" VerticalAlignment="Center"/><TextBox x:Name="RamBox" Grid.Row="3" Grid.Column="1" Padding="8"/>
            <TextBlock Text="JVM аргументы" Grid.Row="4" VerticalAlignment="Center"/><TextBox x:Name="JvmBox" Grid.Row="4" Grid.Column="1" Padding="8"/>
            <TextBlock Text="Прокси" Grid.Row="5" VerticalAlignment="Center"/><TextBox x:Name="ProxyBox" Grid.Row="5" Grid.Column="1" Padding="8" ToolTip="host:port или host:port:user:password"/>
            <TextBlock Text="Команда /reg" Grid.Row="6" VerticalAlignment="Center"/><TextBox x:Name="RegBox" Grid.Row="6" Grid.Column="1" Padding="8"/>
            <TextBlock Text="Команда /login" Grid.Row="7" VerticalAlignment="Center"/><TextBox x:Name="LoginBox" Grid.Row="7" Grid.Column="1" Padding="8"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="150,12,0,0">
            <CheckBox x:Name="AutoRegBox" Content="Авто /reg" Margin="0,0,18,0"/>
            <CheckBox x:Name="AutoLoginBox" Content="Авто /login"/>
          </StackPanel>
          <TextBlock Text="Запущенные инстансы" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,10"/>
          <ListBox x:Name="RunningList" Height="150" DisplayMemberPath="Status"/>
          <TextBlock x:Name="StatusText" Text="Готово" Foreground="#9EA7B8" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="Профили хранятся локально · команды отправляются только в окна Minecraft" Foreground="#70798A" Margin="4,14,0,0"/>
  </Grid>
</Window>